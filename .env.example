# .env.example — Copy to .env and fill in values

# LLM Configuration (Ollama is default — no key needed)
IACCOSTAGENT_LLM_PROVIDER=ollama
IACCOSTAGENT_LLM_MODEL=qwen3:8b

# Ollama base URL (default: http://localhost:11434)
# Change this if Ollama runs on a remote machine on your network
OLLAMA_BASE_URL=http://localhost:11434

# Optional: OpenAI (if you want cloud LLM instead of local)
# OPENAI_API_KEY=sk-...

# Required if using Infracost backend (free registration at https://infracost.io)
# INFRACOST_API_KEY=ico-...

# Optional: point Infracost at a self-hosted Cloud Pricing API for fully air-gapped use
# INFRACOST_PRICING_API_ENDPOINT=https://internal-cpapi.corp.example.com

# Optional: disable Infracost's anonymous telemetry
# INFRACOST_SELF_HOSTED_TELEMETRY=false
# INFRACOST_DISABLE_REPORT_ALL=true

# Optional: pricesheet path for OpenInfraQuote
# OIQ_PRICESHEET=/path/to/prices.csv

# Optional: GCP API key with Cloud Billing API enabled (for gcp-catalog backend)
# GOOGLE_API_KEY=AIza-...

# Optional: default region passed to cost backends
# IACCOSTAGENT_DEFAULT_REGION=us-east-1

# LANGSMITH variables (if using LangSmith for tracing)
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=lsv2_pt_.....
# LANGSMITH_PROJECT="proj_iaccostagent"
